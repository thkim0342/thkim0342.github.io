      "source": [
        "from sklearn import datasets\n",
        "\n",
        "iris = datasets.load_iris()\n",
        "X = iris.data\n",
        "y = iris.target\n",
        "label_dict = {0: \"Setosa\", 1: \"Versicolor\", 2:\"Virginica\"}"
      ],
