    {
      "cell_type": "markdown",
      "source": [
        "Recall discriminatn score for each class k is:\n",
        "\n",
        "$\\delta_k(x) = \\frac{\\mu_k}{\\sigma^2}x -\\frac{\\mu_k^2}{2\\sigma^2} + logα_k$"
      ],
      "metadata": {
        "id": "8KsBbDYwQBhB"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "n_classes = len(np.unique(y))\n",
        "n_features = X.shape[1]\n",
        "\n",
        "#mean vectors for each class\n",
        "mean_vectors = np.array([X[y == k].mean(axis=0) for k in range(n_classes)])\n",
        "\n",
        "#share variance (assumed equal across classes)\n",
        "S_W = np.zeros((n_features, n_features))\n",
        "for k in range(n_classes):\n",
        "  class_scatter = np.cov(X[y == k], rowvar=False, bias=True)\n",
        "  S_W += class_scatter\n",
        "\n",
        "# average variance across all classes\n",
        "shared_variance = np.mean(np.diag(S_W))\n",
        "\n",
        "# prior probabilities for each class\n",
        "class_priors = np.array([np.mean(y == k) for k in range(n_classes)])\n",
        "\n",
        "#discriminant function\n",
        "def discriminant_function(x):\n",
        "  discriminant_scores = (mean_vectors.dot(x.T)) / shared_variance \\\n",
        "  - (np.sum(mean_vectors**2, axis=1) / (2 * shared_variance)) \\\n",
        "  + np.log(class_priors)\n",
        "\n",
        "  return np.argmax(discriminant_scores)"
      ],
      "metadata": {
        "id": "2T9Sv1iOP94s"
      },
      "execution_count": null,
      "outputs": []
    },
