      "source": [
        "class LogisticRegression:\n",
        "  def __init__(self, learning_rate=0.01, n_iterations=1000): # These parameters are used for Gradient Descent optimization.\n",
        "    self.learning_rate = learning_rate\n",
        "    self.n_iterations = n_iterations\n",
        "    self.weights = None\n",
        "    self.bias = None\n",
        "  #In python, the 'self' parameter in instance methods is essential\n",
        "  def sigmoid(self, z):\n",
        "    return 1 / (1 + np.exp(-z))\n",
        "\n",
        "  def fit(self, X, y):\n",
        "    n_samples, n_features = X.shape\n",
        "    self.weights = np.zeros(n_features)\n",
        "    self.bias = 0\n",
        "\n",
        "    for _ in range(self.n_iterations):\n",
        "      linear_model = np.dot(X, self.weights) + self.bias\n",
        "      y_predicted = self.sigmoid(linear_model)\n",
        "\n",
        "      #Gradient Descent\n",
        "      dw = (1 / n_samples) * np.dot(X.T, (y_predicted - y))\n",
        "      db = (1 / n_samples) * np.sum(y_predicted - y)\n",
        "\n",
        "      self.weights -= dw * self.learning_rate\n",
        "      self.bias -= db * self.learning_rate\n",
        "\n",
        "\n",
        "  def predict(self, X):\n",
        "    linear_model = np.dot(X, self.weights) + self.bias\n",
        "    y_predicted = self.sigmoid(linear_model)\n",
        "\n",
        "    y_predicted_cls = [1 if y > 0.5 else -1 for y in y_predicted]\n",
        "    # y_predicted_cls = np.where(y_predicted > 0.5, 1, -1) // Numpy method\n",
        "\n",
        "    return np.array(y_predicted_cls)\n",
        "\n",
        "def accuracy(y_true, y_pred):\n",
        "    # Compute accaracy\n",
        "    correct = sum(1 for true, pred in zip(y_true, y_pred) if true == pred)\n",
        "    return correct / len(y_true)"
      ],
